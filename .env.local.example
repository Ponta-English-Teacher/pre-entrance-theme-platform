# Copy this file to .env.local and fill in your own key.
# .env.local is already gitignored (see .gitignore's ".env*" entry) — never commit real keys.

# Required for the Writing Tutor (src/app/api/writing-tutor). Without this,
# the endpoint responds with a clear "not configured" message instead of crashing.
OPENAI_API_KEY=

# Optional — defaults to gpt-5.5 if not set.
OPENAI_MODEL=

# ── PESM (Pre-Entrance Study Material) — Supabase ───────────────────────────
# See docs/PESM_SUPABASE_ARCHITECTURE.md for the full architecture and setup
# runbook. Phase 1 only: these enable the Supabase client/proxy plumbing.
# Guest/Demo mode (the entire app today) works with these left blank — no
# feature currently depends on them.

# Public/browser-safe — ships in the client bundle. Safe to expose because
# Row Level Security on every pesm.* table (not key secrecy) is what
# actually protects student data. Found in the Supabase dashboard under
# Project Settings → API. Supabase's current key format is the
# "publishable" key (sb_publishable_...), replacing the older "anon" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never reference from a
# client component. NOT required for ordinary student authentication or any
# normal RLS-protected read/write — RLS alone covers that. Only needed for a
# future privileged admin operation (e.g. a script granting the teacher
# role) that must bypass RLS. Leave blank unless you specifically need that.
# SUPABASE_SECRET_KEY=
